# Application
APP_ENV=production
PORT=3000
FRONTEND_URL=https://your-frontend-domain.com
CDN_URL=https://cdn.your-domain.com

# Database
DB_HOST=your-db-host
DB_PORT=5432
DB_USERNAME=vendure_prod
DB_PASSWORD=strong_password_here
DB_NAME=vendure_production

# Redis
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_here

# Security
COOKIE_SECRET=random_64_char_string_here
SUPERADMIN_USERNAME=admin@yourcompany.com
SUPERADMIN_PASSWORD=very_strong_admin_password
CORS_ORIGIN=https://your-frontend-domain.com,https://admin.your-domain.com
COOKIE_DOMAIN=.your-domain.com

# Email
EMAIL_FROM="Your Shop" <noreply@yourshop.com>
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=apikey
SMTP_PASSWORD=your_sendgrid_api_key

# Stripe
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# Security
IP_BLACKLIST=
IP_WHITELIST=
JWT_SECRET=another_random_64_char_string

# Monitoring
SENTRY_DSN=your_sentry_dsn_here
NEW_RELIC_LICENSE_KEY=your_newrelic_key