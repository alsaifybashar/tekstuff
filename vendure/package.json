{
  "name": "my-shop-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:server": "node dist/index.js",
    "start:worker": "node dist/index-worker.js",
    "migration:generate": "npx vendure migrate",
    "migration:run": "npx vendure migrate --run",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@vendure/admin-ui-plugin": "^2.2.0",
    "@vendure/asset-server-plugin": "^2.2.0",
    "@vendure/core": "^2.2.0",
    "@vendure/elasticsearch-plugin": "^2.2.0",
    "@vendure/email-plugin": "^2.2.0",
    "@vendure/payments-plugin": "^2.2.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "bcrypt": "^5.1.0",
    "dotenv": "^16.0.3",
    "helmet": "^7.0.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.3.0",
    "pg": "^8.11.0",
    "rate-limiter-flexible": "^3.0.0",
    "speakeasy": "^2.0.0",
    "stripe": "^14.0.0",
    "typeorm": "^0.3.17"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.5.0",
    "nodemon": "^3.0.0",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.1.0"
  }
}