    "@vendure/email-plugin": "^3.4.3",
    "@vendure/payments-plugin": "^3.4.3",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.4.1",
    "graphql-tag": "^2.12.6",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.8.0",
    "rate-limiter-flexible": "^8.0.1",
    "speakeasy": "^2.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
