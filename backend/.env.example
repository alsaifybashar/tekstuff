# Server Configuration
NODE_ENV=development
PORT=4000
API_VERSION=v1

# Database
MONGODB_URI=mongodb://localhost:27017/webshop
# For production, use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/webshop

# Redis (for caching and sessions)
REDIS_URL=redis://localhost:6379
# For production, use Redis Cloud or similar:
# REDIS_URL=redis://username:password@host:port

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRES_IN=30d

# Encryption
BCRYPT_ROUNDS=12

# CORS Configuration
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-domain.vercel.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@yourshop.com

# Payment (Stripe)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# Security
SESSION_SECRET=your-session-secret-change-this

# API Keys for external services
GOOGLE_API_KEY=your-google-api-key
ANALYTICS_ID=your-analytics-id

# Development
DEBUG=webshop:*